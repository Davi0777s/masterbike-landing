{%- comment -%}
  Librería de íconos SVG de Master Bike.
  Uso: {% render 'mb-icon', name: 'check' %}  ·  opcional: class: 'ico-lg'
{%- endcomment -%}
{%- assign _c = class | default: 'ico' -%}
{%- case name -%}
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M20 6 9 17l-5-5"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M18 6 6 18M6 6l12 12"/></svg>
  {%- when 'chat' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
  {%- when 'photo' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-6 6"/></svg>
  {%- comment -%} --- máquinas --- {%- endcomment -%}
  {%- when 'eliptica' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><ellipse cx="12" cy="12" rx="9" ry="5"/><path d="M5 15l4-8m10 8-4-8"/><circle cx="9" cy="7" r="1.4"/><circle cx="15" cy="17" r="1.4"/></svg>
  {%- when 'caminadora' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M3 18h12l3-9M3 18l1-3h10"/><path d="M18 9l3-4"/><circle cx="6" cy="20" r="1.4"/><circle cx="15" cy="20" r="1.4"/></svg>
  {%- when 'bici' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><circle cx="6" cy="17" r="3.2"/><circle cx="18" cy="17" r="3.2"/><path d="M6 17l4-8h5l-3 8M9 9h4"/></svg>
  {%- when 'remo' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M4 14l6-2 8 4M4 14l2 4m12-2 2 2M9 12l2-6 4 1"/></svg>
  {%- when 'otra' -%}
    <svg viewBox="0 0 24 24" class="{{ _c }}"><path d="M12 3v4m0 10v4M3 12h4m10 0h4"/><circle cx="12" cy="12" r="3.2"/></svg>
  {%- comment -%} --- diferenciadores --- {%- endcomment -%}
  {%- when 'user' -%}
    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  {%- when 'home' -%}
    <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
  {%- when 'wallet' -%}
    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><circle cx="17" cy="14" r="1.3"/></svg>
  {%- when 'tag' -%}
    <svg viewBox="0 0 24 24"><path d="M20.5 13.5 13 21l-9-9V4h8z"/><circle cx="8.5" cy="8.5" r="1.4"/></svg>
  {%- when 'doc' -%}
