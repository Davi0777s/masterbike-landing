# Variables de entorno del sistema de agenda (copiar a .env.local para desarrollo)
# En producción: se agregan en Vercel → Settings → Environment Variables.

# Público (se puede exponer)
NEXT_PUBLIC_SUPABASE_URL=https://jrjafbzjpuispwagwqmc.supabase.co

# SECRETO — solo servidor. Supabase → Settings → API → "service_role" secret.
# NUNCA subir a git (por eso .env.local está en .gitignore).
SUPABASE_SERVICE_ROLE_KEY=

